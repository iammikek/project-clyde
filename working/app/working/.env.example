# API Credentials for Software Development House
# Copy this file to .env.local and add your actual API keys

# FreeAgent API — create the app at https://dev.freeagent.com/ (My Apps → Create New App)
# Not company Settings. OAuth identifier = client ID; then exchange for access + refresh tokens.
FREEAGENT_CLIENT_ID=paste-oauth-identifier
FREEAGENT_CLIENT_SECRET=paste-oauth-secret
FREEAGENT_ACCESS_TOKEN=
FREEAGENT_REFRESH_TOKEN=
FREEAGENT_PRODUCTION_URL=https://api.freeagent.com/v2

# HubSpot API Configuration
HUBSPOT_API_KEY=your_hubspot_api_key_here
HUBSPOT_ACCESS_TOKEN=your_hubspot_oauth_token_here
HUBSPOT_BASE_URL=https://api.hubapi.com

# Optional: Additional Configuration
ENVIRONMENT=development
LOG_LEVEL=info