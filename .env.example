# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# OpenAI (embeddings)
OPENAI_API_KEY=sk-proj-...

# FreeAgent — OAuth only (no API keys). App: https://dev.freeagent.com/ → My Apps
# Register redirect: http://127.0.0.1:8000/api/integrations/freeagent/callback
# Then Integrations → FreeAgent preset → Connect FreeAgent
FREEAGENT_CLIENT_ID=
FREEAGENT_CLIENT_SECRET=
FREEAGENT_ACCESS_TOKEN=
FREEAGENT_REFRESH_TOKEN=

# Backend
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_WS_URL=ws://localhost:8000

# Working directory (absolute path)
WORKING_DIR=/path/to/project-clyde/working
